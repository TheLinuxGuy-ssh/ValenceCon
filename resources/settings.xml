<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
	<category label="Server Connection">

		<setting label="Server Setup" type="lsep"/>
		<setting label="Detect Valence Server" type="action" action="RunScript(plugin.video.valencecon,0,?mode=DETECT_SERVER)" option="close"/>
		<setting id="server_address" type="text" label="Server URL" default="" visible="true" enable="true" />
		<setting id="verify_cert" type="bool" label="Verify SSL Certificate" default="true" visible="true" enable="true" />

		<setting label="Authentication" type="lsep"/>
		<setting type="sep" />
		<setting label="Change Profile" type="action" action="RunScript(plugin.video.valencecon,0,?mode=CHANGE_PROFILE)" option="close"/>
		<setting id="profile_name" type="text" label="Current Profile" />
		<setting id="api_key" type="text" label="API Key" default="" visible="true" enable="true" />
		<setting id="save_user_to_settings" type="bool" label="Save Credentials" default="true" visible="true" enable="true" />

	</category>
	<category label="Playback">

		<setting label="Cinema" type="lsep"/>
		<setting type="sep" />
		<setting id="play_cinema_intros" type="bool" label="Play Cinema Intros" default="false" visible="true" enable="true" />

		<setting label="Bitrate Limits" type="lsep"/>
		<setting type="sep" />
		<setting id="max_stream_bitrate" type="enum" label="Max Stream Bitrate" values="0.5 Mbps|1 Mbps|1.5 Mbps|2.0 Mbps|2.5 Mbps|3.0 Mbps|4.0 Mbps|5.0 Mbps|6.0 Mbps|7.0 Mbps|8.0 Mbps|9.0 Mbps|10.0 Mbps|12.0 Mbps|14.0 Mbps|16.0 Mbps|18.0 Mbps|20.0 Mbps|25.0 Mbps|30.0 Mbps|35.0 Mbps|40.0 Mbps|100.0 Mbps|1000.0 Mbps [default]|Maximum" visible="true" default="23" />
		<setting id="allow_direct_file_play" type="bool" label="Allow Direct File Play" default="false" visible="true" enable="true" />
		<setting id="force_transcode_h265" type="bool" label="Force Transcode HEVC" default="false" visible="true" enable="true" />
		<setting id="force_transcode_mpeg2" type="bool" label="Force Transcode MPEG-2" default="false" visible="true" enable="true" />
		<setting id="force_transcode_msmpeg4v3" type="bool" label="Force Transcode MS-MPEG4v3" default="false" visible="true" enable="true" />
		<setting id="force_transcode_mpeg4" type="bool" label="Force Transcode MPEG-4" default="false" visible="true" enable="true" />
		<setting id="force_transcode_av1" type="bool" label="Force Transcode AV1" default="false" visible="true" enable="true" />
		<setting id="direct_stream_sub_select" type="select" label="Direct Stream Subtitle Selection" lvalues="Auto|Ask|Off" default="0" visible="true"/>

		<setting label="Transcode Limits" type="lsep"/>
		<setting type="sep" />
		<setting id="force_max_stream_bitrate" type="enum" label="Max Transcode Bitrate" values="0.5 Mbps|1 Mbps|1.5 Mbps|2.0 Mbps|2.5 Mbps|3.0 Mbps|4.0 Mbps|5.0 Mbps|6.0 Mbps|7.0 Mbps [default]|8.0 Mbps|9.0 Mbps|10.0 Mbps|12.0 Mbps|14.0 Mbps|16.0 Mbps|18.0 Mbps|20.0 Mbps|25.0 Mbps|30.0 Mbps|35.0 Mbps|40.0 Mbps|100.0 Mbps|1000.0 Mbps|Maximum" visible="true" default="9" />
		<setting id="playback_max_width" type="select" label="Max Resolution" values="640|720|1024|1280|1440|1600|1920|2600|4096" default="1920" visible="true"/>
		<setting id="playback_video_force_8" type="bool" label="Force 8-bit Video" default="false" visible="true" enable="true"/>
		<setting id="audio_codec" type="select" label="Audio Codec" values="ac3|aac" default="ac3"/>
		<setting id="audio_playback_bitrate" type="select" label="Audio Bitrate" values="128|160|192|256|320|384|448|640" default="256" visible="true"/>
		<setting id="audio_max_channels" type="slider" label="Max Audio Channels" default="8" range="2,1,8" option="int" visible="true"/>
                <setting id="max_play_queue" type="slider" label="Max Play Queue" default="200" range="20, 10, 1000" option="int" visible="true"/>

	</category>
	<category label="Playback Behavior">

		<setting label="Play Next" type="lsep"/>
		<setting type="sep" />
		<setting id="play_next_trigger_time" type="slider" label="Play Next Trigger (seconds)" default="0" range="0,1,180" option="int" visible="true"/>

		<setting label="Resume & Delete Prompts" type="lsep"/>
		<setting type="sep" />
		<setting id="promptPlayNextEpisodePercentage" type="slider" label="Play Next Episode at %" default="90" range="5,1,100" option="int" visible="true"/>
		<setting id="promptPlayNextEpisodePercentage_prompt" type="bool" label="Prompt Before Playing Next" default="true" visible="true" enable="true" />
		<setting id="promptDeleteEpisodePercentage" type="slider" label="Delete Episode at %" default="100" range="5,1,100" option="int" visible="true"/>
		<setting id="promptDeleteMoviePercentage" type="slider" label="Delete Movie at %" default="100" range="5,1,100" option="int" visible="true"/>

		<setting label="Auto Resume" type="lsep"/>
		<setting type="sep" />
		<setting id="forceAutoResume" type="bool" label="Force Auto Resume" default="true" visible="true" enable="true" />
		<setting id="jump_back_amount" type="slider" label="Jump Back on Resume (seconds)" default="15" range="0,1,60" option="int" visible="true"/>

		<setting label="Screensaver" type="lsep"/>
		<setting type="sep" />
		<setting id="stopPlaybackOnScreensaver" type="bool" label="Stop Playback on Screensaver" default="false" visible="true" enable="true" />
		<setting id="changeProfileOnScreenSaver" type="bool" label="Change Profile on Screensaver" default="false" visible="true" enable="true" />
		<setting id="cacheImagesOnScreenSaver" type="bool" label="Cache Images on Screensaver" default="true" visible="true" enable="true" />
		<setting id="cacheImagesOnScreenSaver_interval" type="slider" label="Cache Interval (minutes)" default="0" range="0,1,60" option="int" visible="true"/>

	</category>
	<category label="Library Display">

		<setting label="Item Counts" type="lsep"/>
		<setting type="sep" />
		<setting id="addCounts" type="bool" label="Show Episode Counts" default="false" visible="true" enable="true" />
		<setting id="addResumePercent" type="bool" label="Show Resume %" default="false" visible="true" enable="true" />
		<setting id="addSubtitleAvailable" type="bool" label="Show Subtitle Indicator" default="false" visible="true" enable="true" />
		<setting id="hide_x_filtered_items_count" type="bool" label="Hide Filtered Count" default="false" visible="true" enable="true" />
		<setting id="include_overview" type="bool" label="Include Overview" default="true" visible="true" enable="true" />
		<setting id="include_media" type="bool" label="Include Media Info" default="true" visible="true" enable="true" />
		<setting id="add_user_ratings" type="bool" label="Add User Ratings" default="true" visible="true" enable="true" />
		<setting id="include_people" type="bool" label="Include Cast/Crew" default="false" visible="true" enable="true" />
		<setting id="hide_unwatched_details" type="bool" label="Hide Unwatched Details" default="false" visible="true" enable="true" />
		<setting id="episode_name_format" type="select" label="Episode Name Format" default="{SeriesName} - {ItemName}" values="{SeriesName} - {ItemName}|{ItemName}|S{SeasonIndex}E{EpisodeIndex} - {ItemName}|{SeriesName} - S{SeasonIndex}E{EpisodeIndex} - {ItemName}" />

		<setting label="Grouping & Filtering" type="lsep"/>
		<setting type="sep" />
		<setting id="group_movies" type="bool" label="Group Movies into Collections" default="true" visible="true" enable="true" />
		<setting id="flatten_single_season" type="bool" label="Flatten Single Season" default="true" visible="true" enable="true" />
		<setting id="show_all_episodes" type="bool" label="Show All Episodes Item" default="true" visible="true" enable="true" />
		<setting id="show_empty_folders" type="bool" label="Show Empty Folders" default="false" visible="true" enable="true" />
		<setting id="hide_watched" type="bool" label="Hide Watched" default="true" visible="true" enable="true" />

		<setting label="Rewatch" type="lsep"/>
		<setting type="sep" />
		<setting id="rewatch_days" type="slider" label="Rewatch Days" default="0" range="0,1,365" option="int" visible="true"/>
		<setting id="rewatch_combine" type="bool" label="Combine Rewatch" default="false" visible="true" enable="true" />

		<setting label="Pagination" type="lsep"/>
		<setting type="sep" />
		<setting id="moviePageSize" type="slider" label="Movies Page Size" default="0" range="0,1,100" option="int" visible="true"/>
		<setting id="showPageSize" type="slider" label="TV Shows Page Size" default="0" range="0,1,100" option="int" visible="true"/>
		<setting id="show_x_filtered_items" type="slider" label="Filtered Items Limit" default="20" range="5,1,100" option="int" visible="true"/>

		<setting label="Widgets" type="lsep"/>
		<setting type="sep" />
		<setting id="widget_select_action" type="select" label="Widget Select Action" lvalues="Show Info|Play" default="0" visible="true"/>
		<setting id="interface_mode" type="select" label="Interface Mode" lvalues="Simple|Advanced" default="0" visible="true"/>

	</category>
	
	<category label="Skip Intro/Credits">

		<setting label="Intro Skipper" type="lsep"/>
		<setting id="intro_skipper_action" type="select" label="Action" lvalues="Auto Skip|Manual Skip|Disabled" default="0" visible="true" enable="true" />
		<setting id="intro_skipper_start_offset" type="slider" label="Start Offset (seconds)" default="0" range="0,1,3" option="int" visible="true" enable="true"/>
		<setting id="intro_skipper_end_offset" type="slider" label="End Offset (seconds)" default="1" range="0,1,3" option="int" visible="true" enable="true"/>
		<setting label="Credit Skipper" type="lsep"/>
		<setting id="credit_skipper_action" type="select" label="Action" lvalues="Auto Skip|Manual Skip|Disabled" default="0" visible="true" enable="true" />
		<setting id="credit_skipper_start_offset" type="slider" label="Start Offset (seconds)" default="0" range="0,1,3" option="int" visible="true" enable="true" />
		<setting id="credit_skipper_end_offset" type="slider" label="End Offset (seconds)" default="1" range="0,1,3" option="int" visible="true" enable="true"/>
		<setting label="Commercial Skipper" type="lsep"/>
		<setting id="commercial_skipper_action" type="select" label="Action" lvalues="Auto Skip|Manual Skip|Disabled" default="0" visible="true" enable="true" />
		<setting id="commercial_skipper_start_offset" type="slider" label="Start Offset (seconds)" default="0" range="0,1,3" option="int" visible="true" enable="true"/>
		<setting id="commercial_skipper_end_offset" type="slider" label="End Offset (seconds)" default="1" range="0,1,3" option="int" visible="true" enable="true"/>
		<setting label="Preview Skipper" type="lsep"/>
		<setting id="preview_skipper_action" type="select" label="Action" lvalues="Auto Skip|Manual Skip|Disabled" default="0" visible="true" enable="true" />
		<setting id="preview_skipper_start_offset" type="slider" label="Start Offset (seconds)" default="0" range="0,1,3" option="int" visible="true" enable="true" />
		<setting id="preview_skipper_end_offset" type="slider" label="End Offset (seconds)" default="1" range="0,1,3" option="int" visible="true" enable="true"/>
		<setting label="Recap Skipper" type="lsep"/>
		<setting id="recap_skipper_action" type="select" label="Action" lvalues="Auto Skip|Manual Skip|Disabled" default="0" visible="true" enable="true" />
		<setting id="recap_skipper_start_offset" type="slider" label="Start Offset (seconds)" default="0" range="0,1,3" option="int" visible="true" enable="true"/>
		<setting id="recap_skipper_end_offset" type="slider" label="End Offset (seconds)" default="1" range="0,1,3" option="int" visible="true" enable="true"/>
	</category>

	<category label="Services">

		<setting label="Network" type="lsep"/>
		<setting id="websocket_enabled" type="bool" label="WebSocket Enabled" default="true" visible="true" enable="true" />
		<setting id="override_contextmenu" type="bool" label="Override Context Menu" default="true" visible="true"/>
		<setting id="background_interval" type="slider" label="Background Refresh (minutes)" default="20" range="0,1,120" option="int" visible="true"/>
		<setting id="new_content_check_interval" type="slider" label="New Content Check (minutes)" default="0" range="0,1,300" option="int" visible="true"/>
		<setting id="simple_new_content_check" type="bool" label="Simple New Content Check" default="true" visible="true" enable="true" />
		<setting id="random_movie_refresh_interval" type="slider" label="Random Movie Refresh (minutes)" default="5" range="0,1,60" option="int" visible="true"/>

	</category>
	<category label="Advanced">

		<setting id="deviceName" type="text" label="Device Name" default="ValenceCon" visible="true" enable="true" />
		<setting id="http_timeout" type="slider" label="HTTP Timeout (seconds)" default="60" range="5,1,300" option="int" visible="true" />
		<setting id="profile_count" type="slider" label="Profile Count" default="0" range="0,1,20" option="int" visible="true" />
		<setting id="log_debug" type="bool" label="Debug Logging" default="false" visible="true" enable="true" />
		<setting id="log_timing" type="bool" label="Timing Logs" default="false" visible="true" enable="true" />
		<setting id="use_cache" type="bool" label="Use Cache" default="true" visible="true" enable="true" />
		<setting id="use_cached_widget_data" type="bool" label="Use Cached Widget Data" default="false" visible="true" enable="true" />
		<setting id="showLoadProgress" type="bool" label="Show Load Progress" default="false" visible="true" enable="true" />
		<setting id="suppressErrors" type="bool" label="Suppress Errors" default="false" visible="true" enable="true" />
		<setting id="speed_test_data_size" type="slider" label="Speed Test Size (MB)" default="10" range="1,1,10" option="int" visible="true"/>

	</category>
	<category label="Views">

		<setting id="view-movies" type="text" label="Movies View ID" default="" visible="true" enable="false" />
		<setting id="view-tvshows" type="text" label="TV Shows View ID" default="" visible="true" enable="false" />
		<setting id="view-seasons" type="text" label="Seasons View ID" default="" visible="true" enable="false" />
		<setting id="view-episodes" type="text" label="Episodes View ID" default="" visible="true" enable="false" />
		<setting id="view-sets" type="text" label="Collections View ID" default="" visible="true" enable="false" />

	</category>
	<category label="Sort Methods">

		<setting id="sort-Movies" type="select" label="Movies" lvalues="Default|Title|Year|Date Added|Genre|Rating" default="0" visible="true"/>
		<setting id="sort-BoxSets" type="select" label="Collections" lvalues="Default|Title|Year|Date Added|Genre|Rating" default="0" visible="true"/>
		<setting id="sort-Series" type="select" label="TV Shows" lvalues="Default|Title|Year|Date Added|Genre|Rating" default="0" visible="true"/>
		<setting id="sort-Seasons" type="select" label="Seasons" lvalues="Default|Title|Year|Date Added|Genre|Rating" default="0" visible="true"/>
		<setting id="sort-Episodes" type="select" label="Episodes" lvalues="Default|Title|Year|Date Added|Genre|Rating" default="0" visible="true"/>

	</category>
</settings>